# BizzyBrain: settings for the Bizzybot bridge. Merge these into the box's
# /workspaces/env/agent.env, then restart agent.service. Secrets
# (REGISTRATION_TOKEN, CLAUDE_CODE_OAUTH_TOKEN) arrive via the dropbox.
BIZZYBOT_STATE_DIR=/workspaces/bizzybrain
CLAUDE_CWD=/workspaces/projects
CLAUDE_CHROME=0
CLAUDE_PERMISSION_MODE=bypassPermissions
# Listening protocol, appended to every session's system prompt.
AGENT_PROMPT_FILE=/workspaces/projects/cloud-agents/agents/bizzybrain/PROTOCOL.md
# Follow every channel the app is invited to, not an allow-list.
PASSIVE_LISTEN_ALL=1
# Hold a channel's messages this long before handing them over as one turn.
PASSIVE_FLUSH_S=120
PASSIVE_MAX_MESSAGES=50
