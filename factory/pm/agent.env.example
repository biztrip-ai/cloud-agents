# BzPM: factory settings for the Bizzybot bridge. Merge these into the box's
# /workspaces/env/agent.env, then restart agent.service. Non-secret:
# REGISTRATION_TOKEN, GH_TOKEN and CLAUDE_CODE_OAUTH_TOKEN arrive via the dropbox.
CLAUDE_CWD=/workspaces/projects/btdash
CLAUDE_MODEL=claude-fable-5-1
CLAUDE_CHROME=0
CLAUDE_PERMISSION_MODE=bypassPermissions
# Role protocol, appended to every session's system prompt (read at session start).
AGENT_PROMPT_FILE=/workspaces/projects/cloud-agents/factory/pm/PROTOCOL.md
# Slack user ids of the agents allowed to wake this one with a mention (Builder, Merger).
AGENT_MENTIONS_FROM=<Uxxxx>,<Uyyyy>
# Stop a chain of agent-to-agent turns after this many.
AGENT_CHAIN_LIMIT=25
